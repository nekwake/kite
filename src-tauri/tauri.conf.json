{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite",
  "version": "0.1.0",
  "identifier": "dev.gokberk.kite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kite",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5NzFGRjQ1NzlEQjBEOUQKUldTZERkdDVSZjl4U1RUUFVxbXQ5ZEMrSGNVNUd5MENDM0poeXRubkVLSlFFOVU1VkduQkpPcy8K",
      "endpoints": [
        "https://github.com/nekwake/kite/releases/latest/download/latest.json"
      ]
    }
  }
}